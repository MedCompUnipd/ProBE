# Migrated scientific stages run production implementations; remaining stages fail closed.
# Invoke from the project root, or supply paths relative to --directory.
from pathlib import Path

from probe.workflow.config import PipelineConfig, ROLES

configfile: str(Path(workflow.basedir).parent / "config" / "pipeline.yaml")

cfg = PipelineConfig.from_mapping(config)
FINAL_STAGES = {"05A2", "05C2", "05R_POST", "06C1"}

PROJECT_ROOT = Path(workflow.basedir).parent.resolve()

