    input:
        ([bundle("00")] if cfg.uses_adapter else []),
        [bundle("01")],
        both("01A_FULL"),
        [bundle("01B0")],
        both("01B1"),
        both("01C"),
        both("02A"),
        both("02B"),
        both("03"),
        both("04A"),
        both("04B"),
        [bundle("04C")],
        both("04D0a"),
        both("04D0b"),
        [bundle("04D1")],
        both("04D2"),
        both("04E"),
        [bundle("05A")],
        [bundle("05B")],
        both("05R0"),
        both("05R1"),
        [bundle("05A2")],
        [bundle("05C2")],
        [bundle("05R_POST")],
        both("05D"),
        [bundle("06A")],
        [bundle("NONEXACT")],
        [bundle("06C0")],
        [bundle("06C1")],
    log:
        stage_log("validate_artifacts")
    params:
        deep=cfg.data["validation"]["deep_checksums"]
    script:
        "scripts/validate_bundles.py"
