    str(PROJECT_ROOT / "cpp" / "src" / "probe_raw_ox_extract_v1.cpp"),
]


def bundle(stage, role=None):
    """Return the completion manifest tracked by Snakemake for a stage bundle."""
    root = cfg.data["locations"]["output" if stage in FINAL_STAGES else "work"]
    return str(
        Path(root)
        / (role or "common")
        / stage
        / "manifest.json"
    )


def stage_log(stage, role=None):
    return str(Path(cfg.data["locations"]["logs"]) / (role or "common") / (stage + ".log"))


def both(stage):
    return [bundle(stage, role) for role in ROLES]


wildcard_constraints:
    role="START|END"

rule all:
    input:
        bundle("06C1"),
        bundle("05R_POST")

if cfg.uses_adapter:
    rule stage_00:
        input:
            cfg.target_inputs()
        output:
            bundle("00")
        log:
            stage_log("00")
        params:
            stage="00",
            scientific=cfg.data["scientific"],
            ontology=cfg.data["ontology"],
            release_config=cfg.data["releases"],
            target_contract=cfg.data["targets"]
        threads:
            cfg.resources("00")["threads"]
        resources:
            mem_mb=cfg.resources("00")["mem_mb"],
            runtime=cfg.resources("00")["runtime_minutes"]
        script:
            "scripts/unimplemented_stage.py"

rule build_release_fasta:
    input:
        RELEASE_FASTA_BUILD_INPUTS
    output:
        RELEASE_FASTA_BINARY
    log:
        stage_log("build-release-fasta")
    params:
        project_root=str(PROJECT_ROOT)
    shell:
        "cd {params.project_root:q} && pixi run build-release-fasta > {log:q} 2>&1"

